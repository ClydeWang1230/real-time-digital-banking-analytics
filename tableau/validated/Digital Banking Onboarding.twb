<?xml version='1.0' encoding='utf-8'?>
<workbook original-version="18.1" source-build="2026.1.0" source-platform="win" version="18.1">
  <preferences>
    <preference name="ui.encoding.shelf.height" value="24" />
    <preference name="ui.shelf.height" value="26" />
  </preferences>
  <datasources>
    <datasource hasconnection="false" inline="true" name="Parameters" version="18.1">
      <aliases enabled="yes" />
      <column caption="Select dataset" datatype="string" name="[Batch]" param-domain-type="list" role="measure" type="nominal" value="&quot;Simulation A | seed 42&quot;">
        <calculation class="tableau" formula="&quot;Simulation A | seed 42&quot;" />
        <members>
          <member value="&quot;Historical baseline | 505 events&quot;" />
          <member value="&quot;Simulation A | seed 42&quot;" />
          <member value="&quot;Simulation B | seed 7&quot;" />
        </members>
      </column>
    </datasource>
    <datasource caption="Batch KPIs" inline="true" name="textscan.kpis" version="18.1">
      <connection class="textscan" directory="Data" filename="kpis.csv" password="" server="">
        <relation name="kpis.csv" table="[kpis#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="dataset_label" ordinal="0" />
            <column datatype="string" name="run_id" ordinal="1" />
            <column datatype="integer" name="started_sessions" ordinal="2" />
            <column datatype="integer" name="account_opened_sessions" ordinal="3" />
            <column datatype="integer" name="first_transaction_sessions" ordinal="4" />
            <column datatype="integer" name="not_completed_sessions" ordinal="5" />
            <column datatype="real" name="account_rate" ordinal="6" />
            <column datatype="real" name="transaction_rate" ordinal="7" />
            <column datatype="string" name="account_display" ordinal="8" />
            <column datatype="string" name="transaction_display" ordinal="9" />
            <column datatype="string" name="started_detail" ordinal="10" />
            <column datatype="string" name="account_detail" ordinal="11" />
            <column datatype="string" name="transaction_detail" ordinal="12" />
            <column datatype="string" name="quality_status" ordinal="13" />
            <column datatype="integer" name="quality_warnings" ordinal="14" />
            <column datatype="string" name="context_label" ordinal="15" />
            <column datatype="string" name="quality_label" ordinal="16" />
            <column datatype="string" name="insight" ordinal="17" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Dataset Label" datatype="string" name="[dataset_label]" role="dimension" type="nominal" />
      <column caption="Run Id" datatype="string" name="[run_id]" role="dimension" type="nominal" />
      <column caption="Started Sessions" datatype="integer" name="[started_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Account Opened Sessions" datatype="integer" name="[account_opened_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="First Transaction Sessions" datatype="integer" name="[first_transaction_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Not Completed Sessions" datatype="integer" name="[not_completed_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Account Rate" datatype="real" name="[account_rate]" role="measure" type="quantitative" default-format="p0.0%" />
      <column caption="Transaction Rate" datatype="real" name="[transaction_rate]" role="measure" type="quantitative" default-format="p0.0%" />
      <column caption="Account Display" datatype="string" name="[account_display]" role="dimension" type="nominal" />
      <column caption="Transaction Display" datatype="string" name="[transaction_display]" role="dimension" type="nominal" />
      <column caption="Started Detail" datatype="string" name="[started_detail]" role="dimension" type="nominal" />
      <column caption="Account Detail" datatype="string" name="[account_detail]" role="dimension" type="nominal" />
      <column caption="Transaction Detail" datatype="string" name="[transaction_detail]" role="dimension" type="nominal" />
      <column caption="Quality Status" datatype="string" name="[quality_status]" role="dimension" type="nominal" />
      <column caption="Quality Warnings" datatype="integer" name="[quality_warnings]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Context Label" datatype="string" name="[context_label]" role="dimension" type="nominal" />
      <column caption="Quality Label" datatype="string" name="[quality_label]" role="dimension" type="nominal" />
      <column caption="Insight" datatype="string" name="[insight]" role="dimension" type="nominal" />
      <column caption="Selected dataset" datatype="boolean" name="[Selected batch]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[dataset_label] = [Parameters].[Batch]" />
      </column>
    </datasource>
    <datasource caption="Ordered funnel" inline="true" name="textscan.funnel" version="18.1">
      <connection class="textscan" directory="Data" filename="funnel.csv" password="" server="">
        <relation name="funnel.csv" table="[funnel#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
            <column datatype="string" name="dataset_label" ordinal="0" />
            <column datatype="string" name="run_id" ordinal="1" />
            <column datatype="integer" name="step" ordinal="2" />
            <column datatype="string" name="stage_display" ordinal="3" />
            <column datatype="integer" name="sessions" ordinal="4" />
            <column datatype="real" name="from_start_rate" ordinal="5" />
            <column datatype="string" name="reach_label" ordinal="6" />
            <column datatype="string" name="transition_display" ordinal="7" />
            <column datatype="integer" name="previous_sessions" ordinal="8" />
            <column datatype="integer" name="dropoff_sessions" ordinal="9" />
            <column datatype="real" name="dropoff_rate" ordinal="10" />
            <column datatype="string" name="loss_label" ordinal="11" />
          </columns>
        </relation>
      </connection>
      <aliases enabled="yes" />
      <column caption="Dataset Label" datatype="string" name="[dataset_label]" role="dimension" type="nominal" />
      <column caption="Run Id" datatype="string" name="[run_id]" role="dimension" type="nominal" />
      <column caption="Step" datatype="integer" name="[step]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Stage Display" datatype="string" name="[stage_display]" role="dimension" type="nominal" />
      <column caption="Sessions" datatype="integer" name="[sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="From Start Rate" datatype="real" name="[from_start_rate]" role="measure" type="quantitative" default-format="p0.0%" />
      <column caption="Reach Label" datatype="string" name="[reach_label]" role="dimension" type="nominal" />
      <column caption="Transition Display" datatype="string" name="[transition_display]" role="dimension" type="nominal" />
      <column caption="Previous Sessions" datatype="integer" name="[previous_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Dropoff Sessions" datatype="integer" name="[dropoff_sessions]" role="measure" type="quantitative" default-format="n#,##0" />
      <column caption="Dropoff Rate" datatype="real" name="[dropoff_rate]" role="measure" type="quantitative" default-format="p0.0%" />
      <column caption="Loss Label" datatype="string" name="[loss_label]" role="dimension" type="nominal" />
      <column caption="Selected dataset" datatype="boolean" name="[Selected batch]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[dataset_label] = [Parameters].[Batch]" />
      </column>
      <column datatype="boolean" name="[Has previous stage]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[step] &gt; 1" />
      </column>
    </datasource>
    <datasource caption="Channel comparison" inline="true" name="textscan.channels" version="18.1">
      <connection class="textscan" directory="Data" filename="channels.csv" password="" server="">
