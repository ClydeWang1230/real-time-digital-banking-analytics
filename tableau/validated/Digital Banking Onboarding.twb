          <style-rule element="table-div">
            <format attr="line-visibility" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[textscan.kpis].[sum:started_sessions:qk]" />
              <text column="[textscan.kpis].[none:started_detail:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontname="Arial" fontsize="10" fontcolor="#63758A" bold="false">STARTED SESSIONS
</run>
                <run fontname="Arial" fontsize="32" fontcolor="#17324D" bold="true">&lt;[textscan.kpis].[sum:started_sessions:qk]&gt;</run>
                <run fontname="Arial" fontsize="10" fontcolor="#63758A" bold="false">
&lt;[textscan.kpis].[none:started_detail:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#087F83" />
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="false" />
                <format attr="size" value="1" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
        <tooltip-style tooltip-mode="none" />
      </table>
    </worksheet>
