            <column caption="Started Detail" datatype="string" name="[started_detail]" role="dimension" type="nominal" />
            <column caption="Account Detail" datatype="string" name="[account_detail]" role="dimension" type="nominal" />
            <column caption="Transaction Detail" datatype="string" name="[transaction_detail]" role="dimension" type="nominal" />
            <column caption="Quality Status" datatype="string" name="[quality_status]" role="dimension" type="nominal" />
            <column caption="Quality Warnings" datatype="integer" name="[quality_warnings]" role="measure" type="quantitative" default-format="n#,##0" />
            <column caption="Context Label" datatype="string" name="[context_label]" role="dimension" type="nominal" />
            <column caption="Quality Label" datatype="string" name="[quality_label]" role="dimension" type="nominal" />
            <column caption="Insight" datatype="string" name="[insight]" role="dimension" type="nominal" />
            <column caption="Selected dataset" datatype="boolean" name="[Selected batch]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[dataset_label] = [Parameters].[Batch]" />
            </column>
            <column-instance column="[Selected batch]" derivation="None" name="[none:Selected batch:nk]" pivot="key" type="nominal" />
            <column-instance column="[started_detail]" derivation="None" name="[none:started_detail:nk]" pivot="key" type="nominal" />
            <column-instance column="[started_sessions]" derivation="Sum" name="[sum:started_sessions:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[textscan.kpis].[none:Selected batch:nk]">
            <groupfilter function="member" level="[none:Selected batch:nk]" member="true" />
          </filter>
          <slices>
            <column>[textscan.kpis].[none:Selected batch:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="display-field-labels" value="false" />
            <format attr="background-color" value="#FFFFFF" />
          </style-rule>
          <style-rule element="cell">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="12" />
            <format attr="color" value="#17324D" />
            <format attr="text-align" value="left" />
          </style-rule>
          <style-rule element="header">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#17324D" />
          </style-rule>
          <style-rule element="label">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="10" />
            <format attr="color" value="#17324D" />
          </style-rule>
          <style-rule element="pane">
            <format attr="background-color" value="#FFFFFF" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" value="off" />
